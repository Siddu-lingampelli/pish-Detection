# ─── Required ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# JWT secret (required - app will exit without it)
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars

# CORS
CLIENT_URL=http://localhost:3000

# ─── Optional (features degrade gracefully if missing) ──

# Google Safe Browsing API
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API
VIRUSTOTAL_API_KEY=

# URLScan.io API
URLSCAN_API_KEY=

# Cerebras AI (https://cloud.cerebras.ai) - powers ALL AI features:
#   - phishing URL explanations (gpt-oss-120b)
#   - AI assistant chat (gpt-oss-120b)
#   - email analysis (gpt-oss-120b)
#   - screenshot/vision analysis (gemma-4-31b)
CEREBRAS_API_KEY=
