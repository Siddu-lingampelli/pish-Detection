# ─── Required ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# JWT secret (required - app will exit without it)
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars

# CORS
CLIENT_URL=http://localhost:3000

# ─── Optional (features degrade gracefully if missing) ──

# Google Safe Browsing API
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API
VIRUSTOTAL_API_KEY=

# URLScan.io API
URLSCAN_API_KEY=

# Mistral AI API (for AI explanations & assistant)
MISTRAL_API_KEY=

# OpenRouter API Key (for GPT-4o Vision screenshot analysis)
OPENROUTER_API_KEY=
